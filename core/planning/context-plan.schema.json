{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/context-plan.schema.json",
  "title": "ContextPlan",
  "type": "object",
  "required": ["task", "classification", "requiredArtifacts", "requiredEvidence", "validations", "confidence", "unknowns"],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "object",
      "required": ["taskType", "datasource", "risk"],
      "properties": {
        "taskType": { "type": "string", "enum": ["discovery", "implementation", "bugfix", "refactor", "security-review", "architecture", "unknown"] },
        "datasource": { "type": "string", "enum": ["sharepoint", "dataverse", "mixed", "unknown"] },
        "risk": { "type": "string", "enum": ["standard", "elevated", "high"] }
      },
      "additionalProperties": false
    },
    "requiredArtifacts": { "type": "array", "items": { "type": "string" } },
    "requiredEvidence": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "validations": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
