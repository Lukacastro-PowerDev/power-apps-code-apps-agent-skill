{
  "name": "power-apps-code-apps-agent-skill",
  "version": "0.2.0",
  "description": "Universal operational skill library for AI agents building Power Apps Code Apps with SharePoint and Dataverse.",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "inspect": "node dist/scripts/inspect-project.js",
    "context": "node dist/tools/context-plan.js",
    "report": "node dist/tools/validate-report.js",
    "validate:docs": "node dist/tools/validate-docs.js",
    "pack": "node dist/tools/pack-skill.js",
    "evals": "node dist/evals/run-evals.js",
    "audit:secrets": "npm audit --omit=dev --audit-level=high",
    "validate:schema": "node dist/scripts/validate-schema.js",
    "validate:agent-rules": "node dist/scripts/validate-agent-rules.js",
    "generate:context-index": "node dist/scripts/generate-context-index.js",
    "validate:library": "node dist/scripts/validate-library.js",
    "validate": "npm run build && npm run inspect && npm run validate:agent-rules && npm run validate:library && npm run validate:schema && npm run validate:docs && npm run generate:context-index",
    "test": "npm run build && node dist/tests/run-tests.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lukacastro-PowerDev/power-apps-code-apps-agent-skill.git"
  },
  "keywords": ["power-apps", "code-apps", "sharepoint", "dataverse", "ai-agents", "evidence-first"],
  "author": "Lukacastro-PowerDev",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": { "node": ">=20" },
  "bin": {
    "power-apps-skill": "dist/tools/cli.js"
  }
}
