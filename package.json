{
  "name": "power-apps-code-apps-agent-skill",
  "version": "0.2.0",
  "description": "Universal, evidence-first operational skill for AI agents building Power Apps Code Apps.",
  "main": "dist/scripts/cli.js",
  "bin": {
    "power-apps-skill": "dist/scripts/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "inspect": "node dist/scripts/cli.js inspect .",
    "context": "node dist/scripts/cli.js context",
    "validate:schema": "node dist/scripts/validate-schema.js",
    "validate:agent-rules": "node dist/scripts/validate-agent-rules.js",
    "validate:library": "node dist/scripts/validate-library.js",
    "validate:docs": "node dist/scripts/validate-docs.js",
    "validate:security": "node dist/scripts/quality-gates.js --mode standard",
    "generate:context-index": "node dist/scripts/generate-context-index.js",
    "validate": "npm run build && npm run inspect && npm run validate:agent-rules && npm run validate:library && npm run validate:schema && npm run validate:docs && npm run validate:security && npm run generate:context-index",
    "pack": "node dist/scripts/cli.js pack",
    "report:validate": "node dist/scripts/cli.js report --input templates/agent-report/final-report-template.json",
    "evals": "node dist/scripts/run-evals.js --fixtures evals/fixtures --output evals/results/latest-score.json",
    "test": "npm run build && node dist/tests/run-tests.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lukacastro-PowerDev/power-apps-code-apps-agent-skill.git"
  },
  "keywords": [
    "power-apps",
    "code-apps",
    "sharepoint",
    "dataverse",
    "ai-agent",
    "evidence-first"
  ],
  "author": "PowerDev Contributors",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <25"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.9.3"
  },
  "private": true
}
